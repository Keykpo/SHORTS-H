# Application
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/anime_shorts?schema=public"

# Redis (Cache & Sessions)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=500000000
UPLOAD_DIR=./uploads
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm

# AWS S3 / CloudFlare R2 (Video Storage)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=anime-shorts-videos
CDN_URL=https://cdn.animeshorts.com

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_QUALITIES=1080p,720p,480p
THUMBNAIL_COUNT=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (Optional for MVP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@animeshorts.com

# Logging
LOG_LEVEL=debug

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this

# Age Verification
MINIMUM_AGE=18
AGE_VERIFICATION_REQUIRED=true
